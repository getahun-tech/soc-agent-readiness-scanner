{%- macro badge(status) -%}
<span class="badge {{ status | lower | replace('_', '-') }}">{{ status | replace('_', ' ') }}</span>
{%- endmacro -%}
{%- macro check_block(checks) -%}
<ul class="checks">
{% for c in checks %}
  <li class="check">
    <div class="check-head"><span class="check-id">{{ c.check_id }}</span> {{ c.name }} {{ badge(c.status) }}</div>
    {% if c.records_total and c.status != "NOT_ASSESSED" %}<div class="records-failed">{{ c.records_failed }}/{{ c.records_total }} logs failed this check ({{ c.records_failed_percent }}%)</div>{% endif %}
    <ul class="findings">
      {% for f in c.findings %}<li>{{ f }}</li>{% endfor %}
    </ul>
  </li>
{% endfor %}
</ul>
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Event Log Completeness Scanner Report</title>
<style>
  :root {
    --pass: #1a7f37; --warn: #9a6700; --fail: #cf222e; --na: #6e7781;
    --bg: #ffffff; --fg: #1f2328; --muted: #57606a; --border: #d0d7de; --card: #f6f8fa;
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
    background: var(--bg); color: var(--fg); margin: 0; padding: 2rem;
    line-height: 1.5;
  }
  .container { max-width: 960px; margin: 0 auto; }
  h1 { font-size: 1.6rem; margin-bottom: 0.25rem; }
  h2 { font-size: 1.25rem; margin-top: 2.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.4rem; }
  h3 { font-size: 1.05rem; margin-top: 1.5rem; }
  code { background: var(--card); padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.9em; }
  .meta { color: var(--muted); font-size: 0.92rem; }
  .meta dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.15rem 0.75rem; margin: 0.5rem 0; }
  .meta dt { font-weight: 600; color: var(--fg); }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
  th, td { border: 1px solid var(--border); padding: 0.5rem 0.7rem; text-align: left; vertical-align: top; font-size: 0.92rem; }
  th { background: var(--card); }
  .badge { display: inline-block; padding: 0.05rem 0.5rem; border-radius: 999px; font-size: 0.75rem;
    font-weight: 700; letter-spacing: 0.02em; color: #fff; }
  .badge.pass { background: var(--pass); }
  .badge.warn { background: var(--warn); }
  .badge.fail { background: var(--fail); }
  .badge.not-assessed { background: var(--na); }
  .source { border: 1px solid var(--border); border-radius: 8px; padding: 1rem 1.25rem; margin: 1.25rem 0; }
  .source-head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; }
  .source-head h3 { margin: 0; }
  .source-meta { color: var(--muted); font-size: 0.88rem; margin: 0.4rem 0 0.8rem; }
  .scores { display: flex; gap: 1.5rem; flex-wrap: wrap; margin: 0.75rem 0; font-size: 0.92rem; }
  .score-card { background: var(--card); border-radius: 6px; padding: 0.5rem 0.9rem; }
  .score-card .value { font-size: 1.15rem; font-weight: 700; }
  .eligibility { font-weight: 700; padding: 0.3rem 0.6rem; border-radius: 6px; display: inline-block; }
  .eligibility.eligible { background: #dafbe1; color: var(--pass); }
  .eligibility.not-eligible { background: #ffebe9; color: var(--fail); }
  .gate-fail { font-size: 0.88rem; color: var(--fail); margin: 0.15rem 0; }
  .dim-block h4 { margin-bottom: 0.3rem; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--muted); }
  ul.checks { list-style: none; margin: 0; padding: 0; }
  li.check { margin: 0.6rem 0; }
  .check-head { font-size: 0.95rem; }
  .check-id { font-family: ui-monospace, Consolas, monospace; font-weight: 700; }
  ul.findings { margin: 0.2rem 0 0 1.1rem; padding: 0; font-size: 0.88rem; color: var(--muted); }
  .conflict { border-left: 4px solid var(--fail); background: #fff5f5; padding: 0.5rem 0.9rem; margin: 0.5rem 0; font-size: 0.92rem; }
  .conflict.normal { border-left-color: var(--warn); background: #fffbe8; }
  .conflict .cat { font-family: ui-monospace, Consolas, monospace; font-size: 0.78rem; color: var(--muted); }
  .rec { font-size: 0.88rem; border-bottom: 1px solid var(--border); padding: 0.5rem 0; }
  .rec .owner { color: var(--muted); }
  footer { margin-top: 3rem; color: var(--muted); font-size: 0.8rem; }
</style>
</head>
<body>
<div class="container">
  <h1>Event Log Completeness Scanner Report</h1>
  <div class="meta">
    <dl>
      <dt>Config</dt><dd><code>{{ run_metadata.config_path }}</code>{% if run_metadata.config_hash %} <code>sha256:{{ run_metadata.config_hash }}</code>{% endif %}</dd>
      <dt>Version</dt><dd><code>{{ run_metadata.config_version }}</code> / ruleset <code>{{ run_metadata.ruleset_version }}</code></dd>
      <dt>Operator</dt><dd>{{ run_metadata.operator or "unknown" }}</dd>
      <dt>Generated</dt><dd>{{ run_metadata.generated_at }}</dd>
      <dt>Sources scanned</dt><dd>{{ run_metadata.sources_scanned | length }}</dd>
    </dl>
  </div>

  <h2>Estate summary</h2>
  <table>
    <thead><tr><th>Source</th><th>Status</th><th>Note</th></tr></thead>
    <tbody>
    {% for s in sources %}
      <tr><td>{{ s.name }}</td><td>{{ s.status }}</td><td>{{ s.error or "" }}</td></tr>
    {% endfor %}
    </tbody>
  </table>

  <p><strong>Automation eligibility:</strong> {{ estate_summary.eligible_count }}/{{ estate_summary.sources_scanned }} scanned source(s) are automation-eligible.</p>

  {% if estate_summary.top_blocking_gates %}
  <p><strong>Top blocking gates:</strong>
    {% for gate_id, count in estate_summary.top_blocking_gates %}<code>{{ gate_id }}</code> ({{ count }}){{ ", " if not loop.last }}{% endfor %}
  </p>
  {% endif %}

  <h2>Per-source detail</h2>
  {% for s in sources %}
  <div class="source">
    <div class="source-head"><h3>{{ s.name }}</h3></div>
    {% if s.status != "ok" %}
      <p><strong>{{ s.status }}</strong> &mdash; {{ s.error }}</p>
    {% else %}
      <div class="source-meta">
        adapter <code>{{ s.adapter }}</code> &middot;
        owner {{ s.owner }} &middot;
        sample {{ s.sample.actual_size }}/{{ s.sample.requested_size }} (strategy={{ s.sample.strategy }}, seed={{ s.sample.seed }}, population={{ s.sample.population_size }})
      </div>

      <div class="scores">
        <div class="score-card">Completeness<br><span class="value">{{ s.verdict.completeness.score }}/{{ s.verdict.completeness.denominator }}</span>{% if s.verdict.completeness.percent is not none %} <span class="label">({{ s.verdict.completeness.percent }}%)</span>{% endif %} <span class="label">(C6 excluded)</span></div>
        <div>
          <span class="eligibility {{ 'eligible' if s.verdict.eligibility.eligible else 'not-eligible' }}">
            {{ "ELIGIBLE" if s.verdict.eligibility.eligible else "NOT ELIGIBLE" }}
          </span>
          {% if not s.verdict.eligibility.eligible %}
            {% for g in s.verdict.eligibility.gates %}
              {% if not g.passed %}<div class="gate-fail"><strong>{{ g.gate_id }}</strong> ({{ g.description }}): {{ g.reason }} &mdash; owner: {{ g.owning_team_email }}</div>{% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </div>

      {% if s.checks %}
      <div class="dim-block">
        <h4>Completeness (C1&ndash;C7)</h4>
        {{ check_block(s.checks) }}
      </div>
      {% endif %}
    {% endif %}
  </div>
  {% endfor %}

  <h2>Conflicts</h2>
  {% if conflicts %}
    {% for c in conflicts %}
    <div class="conflict {{ c.severity }}">
      <span class="cat">[{{ c.severity | upper }}] {{ c.category }}</span> &mdash; {{ c.sources | join(', ') }}<br>
      {{ c.description }}
    </div>
    {% endfor %}
  {% else %}
    <p>No conflicts detected.</p>
  {% endif %}

  <h2>Recommendations</h2>
  {% if recommendations %}
    {% for r in recommendations %}
    <div class="rec">{{ badge(r.status) }} <strong>{{ r.source }}</strong> / {{ r.check_id }} ({{ r.check_name }})<br>
      <span class="owner">owner: {{ r.owner }}</span><br>{{ r.finding }}</div>
    {% endfor %}
  {% else %}<p>None.</p>{% endif %}

  <footer>Generated by the Event Log Completeness Scanner. Standalone report &mdash; no external assets.</footer>
</div>
</body>
</html>
